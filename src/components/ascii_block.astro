---
interface Props {
  size: string;
  color: string;
}
const { size, color } = Astro.props;

---

<style define:vars={{size, color}}>
    pre {
        line-height: 1.2;
        font-size: var(--size);
        pointer-events: none;
        user-select: none;
        color: var(--color);
        background-color: var(--gray-1);
    }
</style>

<pre aria-hidden="true" id="block"><slot/></pre>