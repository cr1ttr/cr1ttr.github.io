---
import { number } from 'astro:schema';

interface Props {
  label?: string;
  borderStyle?: string;
  flexAlign?: string;
  flexJustify?: string;
  labelBgColor?: string;
  bgColor?: string;
  fontSize?: string;
  borderColor?: string;
  fontColor?: string;
  labelBorderSize?: string;
  labelBorderColor?: string;
  labelColor?: string;
  width?: string;
  height?: string;
}

const {
  label,
  borderStyle = 'solid',
  flexJustify = 'initial',
  flexAlign = 'initial',
  labelBgColor = 'var(--color-background)',
  bgColor = 'inherit',
  fontSize = '0.75rem',
  borderColor = 'var(--gray-9)',
  fontColor = 'inherit',
  labelBorderSize = '0px',
  labelBorderColor = 'transparent',
  labelColor = 'var(--yellow-11)',
  width = '100%',
  height = '100%'
} = Astro.props;
---
<style define:vars={{
  borderStyle, flexAlign, flexJustify,
  labelBgColor, bgColor, fontSize,
  borderColor, fontColor, labelColor,
  labelBorderSize, labelBorderColor,
  width, height
}}>
  .ascii-box {
    position: relative;
    display: flex;
    flex-direction: column;
    width: fit-content;
    border-width: 1px;
    border-color: var(--borderColor);
    border-style: var(--borderStyle);
    background-color: var(--gray-1);
    border-radius: 6px;
    color: var(--fontColor);
    font-size: var(--fontSize);
    padding: 1.5rem 1rem 1rem 1rem;
    align-self: var(--flexAlign);
    justify-content: var(--flexJustify);
    width: var(--width);
    height: var(--height);
  }
  .ascii-box__label {
    position: relative;
    top: -2.2rem;
    left: -0.9rem;
    margin-bottom: -2.2rem;
    align-self: flex-start;
    width: fit-content;
    margin-left: 0.3rem;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--labelBgColor);
    color: var(--labelColor);
    border-color: var(--labelBorderColor);
    border-width: var(--labelBorderSize);
    border-style: solid;
    padding: 0.25rem 0.5rem;
    font-size: var(--fontSize);
    border-radius: 8px;
  }
  .ascii-box--no-label {
    padding-top: 1rem;
  }
</style>
<div class:list={['ascii-box', { 'ascii-box--no-label': !label }]}>
    {label && <span class="ascii-box__label">{label}</span>}
    <slot/>
</div>
