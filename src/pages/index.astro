---
import DefaultLayout from "../layout/default_layout.astro";
import AsciiBlock from "../components/ascii_block.astro";
import icon from '/icon.txt?raw';
import flavor from '/flavor.txt?raw';
import AsciiContainer from "../components/ascii_container.astro";
import Block88x31 from "../components/88x31_block.astro";
import IMAGE_ANCHORS from "../data/88x31_data"
import FaIcon from "../components/fa_icon.astro";


import {
  CURRENTLY_LISTENING_ARTIST,
  CURRENTLY_LISTENING_KEY_ART,
  CURRENTLY_LISTENING_NAME,
  CURRENTLY_LISTENING_REDIRECT,
  CURRENTLY_PLAYING_DEVELOPER,
  CURRENTLY_PLAYING_KEY_ART,
  CURRENTLY_PLAYING_PUBLISHER,
  CURRENTLY_PLAYING_REDIRECT,
  CURRENTLY_PLAYING_NAME
} from "../data/index_supplements";
import CommentHeader from "../components/comment_header.astro";
import DonateButton from "../components/donate_button.astro";
import Marquee from "../components/marquee.astro";
import Matrix from "../components/matrix.astro";

const response = await fetch("http://api.quotable.io/quotes/random");
const [quote] = await response.json();

---

<style>
    .index-containers {
        margin: 2em;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1em;
    }

    .hero {
        display: flex;
        flex-direction: row;
        gap: 1em;
    }

    .badges-section {
        display: flex;
        gap: 1em;
    }

    .currently-doing {
        display: flex;
        flex-direction: row;
        gap: 1em;
    }


    #currently-playing, #currently-listening {
        filter: grayscale();
        border-radius: 6px;
        object-fit: cover;
    }

    #currently-playing:hover, #currently-listening:hover {
        filter: none;
    }

    .currently-listening {
        width: 100%;
    }

    #currently-playing {
        width: 200px;
        height: auto;
    }

    .currently-playing, .currently-listening {
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        align-items: space-around;
        gap: 0.6em;
        text-align: center;
        height: 100%;
    }

    .currently-playing span, .currently-listening span {
        display: flex;
        flex-direction: column;
        gap: 0.25em;
        font-size: 0.85em;
        color: var(--gray-11);
    }

    #currently-listening {
        width: 100px;
        height: auto;
    }

    @media (max-width: 800px) {
        #donation-block {
            display: none;
        }

        .badges-section {
            flex-direction: column;
        }

        .hero {
            flex-direction: column;
            align-items: center;
        }

        .currently-doing {
            flex-direction: column;
            align-items: center;
        }

        #icon {
            text-align: center;
            width: 100%;
        }

        #currently-listening {
            min-width: 100%;
        }

        /* #currently-playing, #currently-listening {
            width: 100%;
        } */



    }
</style>

<DefaultLayout
    title="Home"
    description="cr1ttr's personal site"
    openGraphTitle="home"
    openGraphImage="/favicon.png"
>

    <div id="qotd" style="width: 100%;">
        <Marquee>
            "{quote.content}" - {quote.author}
        </Marquee>
    </div>

    <div class="index-containers">
        <Matrix/>
        <div id="donation-block">
            <AsciiContainer>
                <p style="text-align: center">
                    Like what I do? Please consider <span style="color: var(--yellow-11)">donating</span>!<br/><br/>
    
                    <span style="color: var(--yellow-8)">
                        - All donations go directly towards supporting me.<br/>
                        - All donors will be listed on the site permanently, as a thank you.<br/>
                            - Please leave a preferred name in the recipient message.<br/><br/>
                    </span>
    
                    <DonateButton/>
                </p>
            </AsciiContainer>
        </div>

        <div class="hero">
            <div id="icon"><AsciiBlock size="3px" color="var(--yellow-11)">{icon}</AsciiBlock></div>
            <div class="currently-doing">
                <AsciiContainer label='Currently Playing: '>
                    <div class="currently-playing">
                        <a href={CURRENTLY_PLAYING_REDIRECT}><img id="currently-playing" src={CURRENTLY_PLAYING_KEY_ART}></a>
                        <span>
                            <br/>
                            {CURRENTLY_PLAYING_NAME}
                            <br/>
                            {CURRENTLY_PLAYING_DEVELOPER} - {CURRENTLY_PLAYING_PUBLISHER}
                        </span>
                    </div>
                </AsciiContainer>
                <AsciiContainer label = "Currently Listening To:">
                    <div class="currently-listening">
                    <a href={CURRENTLY_LISTENING_REDIRECT} style="display: flex; justify-content: center;"><img id="currently-listening" src={CURRENTLY_LISTENING_KEY_ART}></a>
                    <span>
                        <br/>
                        {CURRENTLY_LISTENING_NAME}
                        <br/>
                        {CURRENTLY_LISTENING_ARTIST}
                    </span>
                    </div>
                </AsciiContainer>
            </div>
        </div>


        <div class="badges-section">
            <AsciiContainer label='add my button!'>
                <div style="display: flex; justify-content: center; align-items: center;">
                    <a href="https://cr1ttr.github.io"><img src='/badges/cr1ttr-88x31.gif'></a>
                </div>
            </AsciiContainer>
            <Block88x31 images={IMAGE_ANCHORS} rowLength={5} title="check these people out!"/>
        </div>
    </div>
</DefaultLayout>