---
import DefaultLayout from "../layout/default_layout.astro";
import AsciiBlock from "../components/ascii_block.astro";
import icon from '/icon.txt?raw';
import flavor from '/flavor.txt?raw';
import AsciiContainer from "../components/ascii_container.astro";
import Block88x31 from "../components/88x31_block.astro";
import IMAGE_ANCHORS from "../data/88x31_data"

---

<style>
    .index-containers {
        margin: 2em;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1em;
    }

    .qc-webring {
        display: flex;
        flex-direction: row;
    }

    .block-88x31-container {
        display: flex;
        flex-direction: column;
        gap: 1em;
    }

    .block-88x31 {
        display: flex;
        gap: 1em;
        flex-direction: row;
        justify-content: center;
    }


</style>

<DefaultLayout
    title="Home"
    description="cr1ttr's personal site"
    openGraphTitle="home"
    openGraphImage="/favicon.png"
>
    <AsciiBlock size="4px" color="var(--yellow-11)">{icon}</AsciiBlock>
    <div class="index-containers">
        <AsciiContainer label="welcome to my website!"><p>
            - use the `cd` command or the buttons on the nav to get around.<br/>
            - disable oneko with `no-neko` (not implemented)<br/>
            - disable crt-overlay with `no-crt` (not implemented)<br/>
        </p></AsciiContainer>
        <AsciiBlock size="4px" color="var(--gray-8)">{flavor}</AsciiBlock>
        <div class="qc-webring">
            <a href="https://webring.queercoded.dev/prev?source=cr1ttr.github.io"><img src="/button-prev.png"/></a>
            <a href="https://webring.queercoded.dev/"><img src="/88x31.gif"/></a>
            <a href="https://webring.queercoded.dev/next?source=cr1ttr.github.io"><img src="/button-next.png"/></a>
        </div>
          <Block88x31 images={IMAGE_ANCHORS} rowLength={4}/>


