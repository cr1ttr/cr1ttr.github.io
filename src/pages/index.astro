            <div class="block-88x31">
                <a href="https://cr1ttr.github.io/"><img src="/cr1ttr-88x31.gif"/></a>
                <a href="https://null-version-nova.github.io/"><img src="/manynamedangel.gif"/></a>
                <a href="https://sugrstrz.com/"><img src="/SugrBadge.png"/></a>
                <a href="https://mint.pages.gay/"><img src="/mint-88x31.gif"/></a>
            </div>
            <div class="block-88x31">
                <a href="https://zoey-on-github.github.io/"><img src="/julie-88x31.png"/></a>
            </div>
        </div> -->
    </div>
</DefaultLayout>


